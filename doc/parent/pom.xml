<?xml version="1.0" encoding="UTF-8"?>
<!--
	Modelio parent POM
 -->
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.modelio</groupId>
	<artifactId>doc-parent</artifactId>
	<version>5.4.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<modelio.version>[5.4.1,5.4.2)</modelio.version>
		<!--
			The documentation reactor does not define the supported runtime Java contract, but its inherited
			compiler metadata should still stay consistent with the shared Java 21 build baseline now used by
			the validated workspace and runtime/plugin tree.
		-->
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.source>21</maven.compiler.source>
		<tycho-groupid>org.eclipse.tycho</tycho-groupid>
		<tycho-version>5.0.2</tycho-version>

		<!-- to convert Asciidoc to html files-->
		<html.directory>html</html.directory>
		<adoc.directory>adoc</adoc.directory>
		<doc.stylesheet.directory>${project.basedir}/../../../stylesheet</doc.stylesheet.directory>
		<css.path>../../modeliosoft.css</css.path>
		<asciidoctor.version>1.5.7.1</asciidoctor.version>
		<phase.generate-documentation>package</phase.generate-documentation>

	</properties>

	<repositories>
	</repositories>

	<build>

		<plugins>
			<plugin>
				<groupId>${tycho-groupid}</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho-version}</version>
				<extensions>true</extensions>
				<configuration>
					<resolver>p2</resolver>
				</configuration>
			</plugin>
			<plugin>
				<groupId>${tycho-groupid}</groupId>
				<artifactId>tycho-packaging-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<strictVersions>false</strictVersions>
					<strictBinIncludes>false</strictBinIncludes>
					<archive>
						<!-- don't create the maven directory (descriptor files) in META-INF -->
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
		</plugins>

	</build>

	<profiles>
		<profile>
			<id>doc-plugin-with-adoc</id>
			<activation>
				<file>
					<exists>${project.basedir}/${adoc.directory}</exists>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.2.0</version>
						<configuration>
							<filesets>
								<fileset>
									<directory>${project.basedir}/${html.directory}</directory>
									<includes>
										<include>**/*</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
						<executions>
							<execution>
								<id>clean-generated-doc-html-before-gen</id>
								<phase>initialize</phase>
								<goals>
									<goal>clean</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.asciidoctor</groupId>
						<artifactId>asciidoctor-maven-plugin</artifactId>
						<version>${asciidoctor.version}</version>
						<executions>
							<execution>
								<id>output-html</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>process-asciidoc</goal>
								</goals>
								<configuration>
									<headerFooter>true</headerFooter>
									<sourceDirectory>${adoc.directory}</sourceDirectory>
									<outputDirectory>${html.directory}</outputDirectory>
									<preserveDirectories>true</preserveDirectories>
									<backend>html5</backend>
									<sourceHighlighter>coderay</sourceHighlighter>
									<attributes>
										<stylesheet>modeliosoft.css</stylesheet>
										<linkcss>true</linkcss>
										<imagesdir>.</imagesdir>
									</attributes>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>copy-doc-stylesheet</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.basedir}/${html.directory}</outputDirectory>
									<resources>
										<resource>
											<directory>${doc.stylesheet.directory}</directory>
											<includes>
												<include>modeliosoft.css</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
