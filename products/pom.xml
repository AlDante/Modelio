<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>products</artifactId>
	<packaging>eclipse-repository</packaging>

	<parent>
		<groupId>org.modelio</groupId>
		<artifactId>modelio-parent</artifactId>
		<version>5.4.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>copy-p2-resources</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>

						<configuration>
							<outputDirectory>${basedir}/target</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/p2repository</directory>
									<includes>
										<include>changelog.html</include>
										<include>style.css</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
	<!-- The following profiles allow to choose the Modelio packagings -->
		<!-- Enable theses profiles in order to package them -->
		<!-- - product.org -->
		<!-- - product.com -->
		<!-- - product.saas -->
		<!-- - platform.mac.aarch64 -->
		<!-- - repositoryP2 -->
		<profile>
			<id>product.org</id>
			<build>
				<plugins>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>tycho-p2-repository-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<skipArchive>true</skipArchive>
							<createArtifactRepository>false</createArtifactRepository>
						</configuration>
					</plugin>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>tycho-p2-director-plugin</artifactId>
						<version>${tycho-version}</version>
						<executions>
							<execution>
								<id>products</id>
								<phase>package</phase>
								<goals>
									<goal>materialize-products</goal>
									<goal>archive-products</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<products>
								<product>
									<id>org.modelio.product</id>
									<attachId>OpenSource</attachId>
									<rootFolder>${modelio.rootFolder}</rootFolder>
								</product>
							</products>
							<installFeatures>true</installFeatures>
							<profile>DefaultProfile</profile>
						<formats>
							<macosx>tar.gz</macosx>
						</formats>
					</configuration>
				</plugin>
				<plugin>
					<artifactId>maven-antrun-plugin</artifactId>
					<version>3.1.0</version>
					<executions>
							<execution>
								<id>validate-macos-aarch64-feature-repin</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<exec executable="python3" failonerror="true">
											<arg value="${project.basedir}/../diagnostics/macos-aarch64/validate_feature_repin.py"/>
											<arg value="--repo-root"/>
											<arg value="${project.basedir}/.."/>
										</exec>
									</target>
								</configuration>
							</execution>
						<execution>
							<id>patch-macos-aarch64-app-wrapper</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<exec executable="python3" failonerror="true">
										<arg value="${project.basedir}/patch_and_archive_macos_aarch64_product.py"/>
										<arg value="--app"/>
										<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
										<arg value="--patch-script"/>
										<arg value="${project.basedir}/patch_macos_aarch64_app.py"/>
										<arg value="--app-name"/>
										<arg value="Modelio"/>
										<arg value="--short-version"/>
										<arg value="${newVersion}"/>
									</exec>
								</target>
							</configuration>
						</execution>
						<execution>
							<id>verify-macos-aarch64-app-wrapper</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<exec executable="python3" failonerror="true">
										<arg value="${project.basedir}/verify_macos_aarch64_app.py"/>
										<arg value="--app"/>
										<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
									</exec>
								</target>
							</configuration>
						</execution>
							<execution>
								<id>validate-macos-aarch64-contract</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<exec executable="python3" failonerror="true">
											<arg value="${project.basedir}/../diagnostics/macos-aarch64/validate_macos_aarch64_contract.py"/>
											<arg value="--repo-root"/>
											<arg value="${project.basedir}/.."/>
											<arg value="--app"/>
											<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
										</exec>
									</target>
								</configuration>
							</execution>
																			<execution>
																				<id>validate-logging-stack</id>
																				<phase>package</phase>
																				<goals>
																					<goal>run</goal>
																				</goals>
																				<configuration>
																					<target>
																						<exec executable="python3" failonerror="true">
																							<arg value="${project.basedir}/../diagnostics/macos-aarch64/validate_logging_stack.py"/>
																							<arg value="--repo-root"/>
																							<arg value="${project.basedir}/.."/>
																							<arg value="--app"/>
																							<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
																						</exec>
																					</target>
																				</configuration>
																			</execution>
																																																	<execution>
																																																		<id>verify-runtime-logging-smoke</id>
																																																		<phase>package</phase>
																																																		<goals>
																																																			<goal>run</goal>
																																																		</goals>
																																																		<configuration>
																																																			<target>
																																																				<exec executable="python3" failonerror="true">
																																																					<arg value="${project.basedir}/../diagnostics/macos-aarch64/verify_runtime_logging_smoke.py"/>
																																																					<arg value="--app"/>
																																																					<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
																																																					<arg value="--timeout"/>
																																																					<arg value="45"/>
																																																				</exec>
																																																			</target>
																																																		</configuration>
																																																	</execution>
						<execution>
							<id>verify-macos-aarch64-diagram-editor-smoke</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<exec executable="python3" failonerror="true">
										<arg value="${project.basedir}/../diagnostics/macos-aarch64/verify_diagram_editor_smoke.py"/>
										<arg value="--app"/>
										<arg value="${project.build.directory}/products/org.modelio.product/macosx/cocoa/aarch64/${modelio.rootFolder}.app"/>
									</exec>
								</target>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</build>
	</profile>
		<profile>
			<id>platform.mac.aarch64</id>
			<properties>
				<modelio.rootFolder>Modelio</modelio.rootFolder>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>target-platform-configuration</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<dependency-resolution>
								<extraRequirements>
									<requirement>
										<type>eclipse-plugin</type>
										<id>org.eclipse.equinox.launcher.cocoa.macosx.aarch64</id>
										<versionRange>[1.2.1400.v20250801-0854,1.2.1400.v20250801-0854]</versionRange>
									</requirement>
								</extraRequirements>
							</dependency-resolution>
							<environments>
								<environment>
									<os>macosx</os>
									<ws>cocoa</ws>
									<arch>aarch64</arch>
								</environment>
							</environments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>repositoryP2</id>
			<build>
				<plugins>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>tycho-p2-repository-plugin</artifactId>
						<version>${tycho-version}</version>
						<configuration>
							<skipArchive>false</skipArchive>
							<createArtifactRepository>true</createArtifactRepository>
							<repositoryName>modelio-repository</repositoryName>
						</configuration>
					</plugin>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>tycho-p2-director-plugin</artifactId>
						<version>${tycho-version}</version>
						<executions>
							<execution>
								<id>materialize-products</id>
								<goals>
								</goals>
							</execution>
						</executions>
						<configuration>
							<products>
								<product>
									<id>org.modelio.product</id>
									<attachId>OpenSource</attachId>
								</product>
							</products>
							<installFeatures>true</installFeatures>
							<profile>DefaultProfile</profile>
						</configuration>
					</plugin>
					<plugin>
						<groupId>${tycho-groupid}</groupId>
						<artifactId>target-platform-configuration</artifactId>
						<version>${tycho-version}</version>
						<configuration>
						<environments>
							<environment>
								<os>macosx</os>
								<ws>cocoa</ws>
								<arch>aarch64</arch>
							</environment>
						</environments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
